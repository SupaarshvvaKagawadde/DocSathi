{
  "name": "docsathi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=desktop && playwright test --project=mobile",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"shared/**/*.ts\" \"server/**/*.{ts,mjs}\" \"tests/**/*.ts\" \"*.ts\" index.html package.json .github/workflows/ci.yml",
    "rules": "tsx server/curate.ts",
    "backup": "tsx server/backup.ts",
    "test:benchmark": "vitest run tests/benchmark.test.ts tests/benchmark-v2.test.ts",
    "benchmark:review": "tsx server/benchmark-review.ts",
    "benchmark:run": "tsx server/benchmark-runner.ts",
    "review:approve": "tsx server/reviewer-cli.ts",
    "outbox": "tsx server/outbox.ts",
    "support": "tsx server/support-cli.ts",
    "backup:offsite": "tsx server/offsite-backup.ts",
    "readiness": "tsx server/readiness.ts",
    "capacity": "tsx server/capacity.ts",
    "launch:evidence": "tsx server/launch-evidence.ts",
    "recovery:rehearse": "tsx server/recovery-rehearsal.ts",
    "monitoring:drill": "tsx server/monitoring-drill.ts"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@napi-rs/canvas": "^1.0.11",
    "@tesseract.js-data/eng": "^1.0.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "lucide-react": "^1.54.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
